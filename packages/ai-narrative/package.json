{
  "name": "@wutiankai/npc-dialogue",
  "version": "1.0.0-alpha.2",
  "description": "AI NPC dialogue engine for mystery/investigation games — dialogue generation, gate review, bilingual keyword matching",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": ["ai", "npc", "dialogue", "mystery", "game", "narrative", "gate-review"],
  "license": "MIT",
  "author": "Tucker_Wu <wutiankai179@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiankai-333/storycraft-game.git",
    "directory": "packages/ai-narrative"
  },
  "homepage": "https://github.com/tiankai-333/storycraft-game/tree/main/packages/ai-narrative#readme",
  "bugs": "https://github.com/tiankai-333/storycraft-game/issues",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
